<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:padding="30dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".EjemploConstraintActivity">

    <TextView
        android:id="@+id/text_view_ejemplo_rojo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:text="@string/hola_mundo"
        android:textColor="@color/white"
        android:background="@color/rojo"
        android:elevation="1dp"/>

    <TextView
        android:id="@+id/textciew_ejemplo1"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@color/black"
        android:text="1"
        android:textSize="60sp"
        android:textColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/textciew_ejemplo2"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@color/black"
        android:text="2"
        android:textSize="60sp"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="150dp"
        app:layout_constraintTop_toBottomOf="@+id/textciew_ejemplo1"/>

    <TextView
        android:id="@+id/textciew_ejemplo3"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@color/black"
        android:text="3"
        android:textSize="60sp"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/textciew_ejemplo2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/textciew_ejemplo1">

        <TextView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:text="4"
            style="@style/cajanegradetexto"
            android:layout_marginEnd="15dp"/>

        <TextView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:text="5"
            style="@style/cajanegradetexto"
            android:layout_marginEnd="15dp"/>

        <TextView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:text="6"
            style="@style/cajanegradetexto"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>